# SIHATUNA IRAQ ERP — backend configuration
#
# Copy this file to ".env" in the same folder and fill in real values.
# Never commit the real ".env" file — it is already excluded by .gitignore.

# ============================================================================
# Core (required)
# ============================================================================
# Port the backend listens on. Must stay 8000 to match the frontend build
# and the documented CORS setup unless you also update FRONTEND_URL and
# rebuild the frontend with a matching REACT_APP_API_URL.
PORT=8000

# The URL(s) the frontend is served from — used for CORS. Comma-separate
# more than one if needed (e.g. a second staging address).
FRONTEND_URL=http://localhost:3000

# Signs every login token. Generate a random value — never leave this
# empty or reuse the example. If left unset (or set to the code's known
# built-in default) with NODE_ENV=production, the server refuses to start.
# Generate one: node node-runtime/node.exe -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Encrypts payment-gateway credentials (API keys/secrets) before they are
# stored in the database. Same startup refusal in production if left unset.
# Generate one: node node-runtime/node.exe -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENCRYPTION_KEY=

NODE_ENV=production

# ============================================================================
# PostgreSQL (required)
# ============================================================================
# The database server itself is not bundled with this release — point these
# at a PostgreSQL 18 server you already have running and reachable.
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=sihatuna_iraq

# ============================================================================
# First admin account (optional — used only once, by scripts/bootstrapDatabase.js)
# ============================================================================
# If both are set, the bootstrap script creates the very first admin login
# with these values instead of generating a random password. Only takes
# effect when the users table is still completely empty; ignored afterward.
# Either way, a password change is required on first login.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ============================================================================
# Redis (optional) — caching, rate limiting, and the AI prescription-reader queue
# ============================================================================
# Not required to run the system. Without it: caching and rate limiting
# fail open (no hard limit, just no caching benefit), and the only feature
# that stops working is the AI prescription-reader's background queue —
# everything else behaves identically with or without Redis configured.
REDIS_URL=redis://127.0.0.1:6379

# ============================================================================
# AI diagnosis assistance (optional)
# ============================================================================
# Without either key below, the AI-diagnosis page falls back to local
# common-symptom matching (no real AI) — it still works, just without a
# real model behind it, and the interface says so explicitly.
#
# Recommended: Google Gemini has a free tier with no card required.
# Get a key at https://aistudio.google.com ("Get API key").
GEMINI_API_KEY=
GEMINI_MODEL=

# Alternative: Anthropic Claude (paid). Ignored automatically if
# GEMINI_API_KEY above is set. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# ============================================================================
# Email alerts (optional)
# ============================================================================
# Without these, server-health alerts are still logged locally
# (backend/data/alerts-log.json) and printed to the console — these just
# add an email notification on top of that.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=

# ============================================================================
# HL7 (lab results) and Orthanc/DICOM (radiology images) — both optional
# ============================================================================
# Port the HL7 v2 listener accepts incoming lab-result messages on. 2575 is
# the common default for this purpose — only change it if something else on
# the server already uses it.
HL7_PORT=2575

# Connection details for a separate Orthanc server (free, open-source
# DICOM/PACS software, installed separately — https://www.orthanc-server.com/).
# Leave as-is until an actual radiology device/workflow needs it.
ORTHANC_URL=
ORTHANC_USER=
ORTHANC_PASS=

# ============================================================================
# Payment gateways (all optional — leave any unused one blank)
# ============================================================================
# Cash and Western Union need no API keys; they are recorded manually by
# accounting staff when a payment is received.
ZAINCASH_MERCHANT_ID=
ZAINCASH_SECRET_KEY=
FASTPAY_MERCHANT_ID=
FASTPAY_API_KEY=
QICARD_TERMINAL_ID=
QICARD_API_KEY=
BANK_CARD_GATEWAY_URL=
BANK_CARD_MERCHANT_ID=
BANK_CARD_API_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ============================================================================
# External backup (optional)
# ============================================================================
# A filesystem path to also copy automatic database backups to (e.g. a
# mounted network drive). Leave blank to keep backups local only.
EXTERNAL_BACKUP_DIR=
